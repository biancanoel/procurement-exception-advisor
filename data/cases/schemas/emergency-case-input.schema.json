{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "emergency-case-input.schema.json",
  "title": "Emergency Procurement Case Input",
  "type": "object",
  "additionalProperties": false,
  "anyOf": [
    {"required": ["description"]},
    {"required": ["request_text"]}
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^EM-[0-9]{3}$"
    },
    "title": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "workflow_type": {
      "type": "string",
      "const": "emergency_procurement"
    },
    "jurisdiction": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": ["string", "null"]
        },
        "agency": {
          "type": ["string", "null"]
        }
      }
    },
    "department": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "estimated_amount_usd": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "proposed_vendor": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "request_text": {
      "type": "string",
      "minLength": 1,
      "description": "Legacy JSON-fixture name for the required description."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Required description of the emergency situation."
    },
    "available_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "title",
          "summary"
        ],
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
